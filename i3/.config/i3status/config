general {
        output_format = "i3bar"
        colors = false
        markup = pango
        interval = 5
        color_good = '#2f343f'
		color_degraded = '#ebcb8b'
		color_bad = '#ba5e57'
}

/* order += "load" */
/* order += "cpu_temperature 0" */
/* /1* order += "disk /" *1/ */
/* order += "wireless wlp1s0" */
order += "volume master"
order += "battery 1"
order += "tztime local"


cpu_temperature 0 {
        /* format = "<span background='#bf616a'>  %degrees °C </span>" */
        format = " %degrees °C"
        path = "/sys/class/thermal/thermal_zone0/temp"
}

disk "/" {
        format = " %free Free" 
        /* format = "<span color='#000000' background='#fec7cd'>  %free Free </span>" */
}

wireless wlp1s0 {
        format_up = " %essid"
        format_down = " Disconnected"
        /* format_up = "<span background='#b48ead' color='#ffffff'> 2332  %essid </span>" */
        /* format_down = "<span background='#b48ead'>  Disconnected </span>" */
}

volume master {
        format = " %volume"
        format_muted = " Muted"
        /* format = "<span background='#ebcb8b' color='#000000' >  %volume </span>" */
        /* format_muted = "<span background='#ebcb8b'>  Muted </span>" */
        device = "default"
        mixer = "Master"
        mixer_idx = 0
}

battery 1 {
	last_full_capacity = true
        /* format = "<span background='#a3be8c' color='#00000'>  %status %percentage </span>" */
        format = " %status %percentage"
        format_down = "No Battery"
        status_chr = "Charging"
        status_bat = "Battery"
        status_unk = "Unknown"
        status_full = "Charged"
        path = "/sys/class/power_supply/BAT%d/uevent"
        low_threshold = 10
}

tztime local {
        format = " %Y-%m-%d  %H:%M"
}

load {
        format = " %1min"
}
