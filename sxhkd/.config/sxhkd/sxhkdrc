
# Basic binds
super + Return
	$TERMINAL
super + d
	rofi -show drun -show-icons
super + shift + d
	rofi -show
super + w
	rofi -show window -show-icons
super + r
	$TERMINAL -e ranger
super + b
	firefox
super + e
	thunderbird
super + p
	$TERMINAL -e python
super + s
	skypeforlinux
super + t
	telegram-desktop

super + shift + n
        $TERMINAL -v -e nvim $TERMINAL
